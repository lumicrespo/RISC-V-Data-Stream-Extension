+//===-- RISCVInstrInfoDSE.td - RISC-V 'DSE' instructions ---*- tablegen -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+///
+/// This file describes the RISC-V instructions from the custom 'DSE' data
+/// stream extension.
+///
+//===----------------------------------------------------------------------===//
+
+include "RISCVInstrFormatsDSE.td"
+
+//===----------------------------------------------------------------------===//
+// DSE Stream Start (header) Instruction class templates
+//===----------------------------------------------------------------------===//
+let hasSideEffects = 0, mayLoad = 1, mayStore = 1 in {
+
+// Integer
+class DSE_STREAM_HEADER_I<DSE_StreamType Stype, DSE_StreamWidth width,
+                        DSE_StreamCache cachelvl, DSE_indexStream indexS, 
+                        string opcodestr>
+      : DSE_STREAM_HEADER<Stype, DSE_regtype_I, DSE_StreamDim_NULL, 
+                          DSE_masked_NULL, cachelvl, indexS, width, 
+                          (outs GPR:$sd), (ins GPR:$rs1),
+                          opcodestr, "$sd, $rs1"> {
+  let Predicates = [HasCustomExtDSEI];
+}
+
+multiclass DSE_STREAM_HEADER_I_INDEX<DSE_StreamType Stype, 
+                                     DSE_StreamWidth width, 
+                                     DSE_StreamCache cachelvl, 
+                                     string opcodestr>{
+  def ""    : DSE_STREAM_HEADER_I<Stype, width, cachelvl, DSE_indexS_false, opcodestr>;
+  def _INDX : DSE_STREAM_HEADER_I<Stype, width, cachelvl, DSE_indexS_true, opcodestr # ".indx">;
+}
+
+multiclass DSE_STREAM_HEADER_I_CACHE<DSE_StreamType Stype, 
+                                     DSE_StreamWidth width,
+                                     string opcodestr>{
+  defm "" : DSE_STREAM_HEADER_I_INDEX<Stype, width, DSE_StreamCache_N, opcodestr>;
+  defm _1 : DSE_STREAM_HEADER_I_INDEX<Stype, width, DSE_StreamCache_1, opcodestr # ".lv1">;
+  defm _2 : DSE_STREAM_HEADER_I_INDEX<Stype, width, DSE_StreamCache_2, opcodestr # ".lv2">;
+  defm _3 : DSE_STREAM_HEADER_I_INDEX<Stype, width, DSE_StreamCache_3, opcodestr # ".lv3">;
+}
+
+multiclass DSE_STREAM_HEADER_I_WIDTH<DSE_StreamType Stype, string opcodestr>{
+  defm _B : DSE_STREAM_HEADER_I_CACHE<Stype, DSE_StreamWidth_B, opcodestr # ".b">;
+  defm _H : DSE_STREAM_HEADER_I_CACHE<Stype, DSE_StreamWidth_H, opcodestr # ".h">;
+  defm _W : DSE_STREAM_HEADER_I_CACHE<Stype, DSE_StreamWidth_W, opcodestr # ".w">;
+  defm _D : DSE_STREAM_HEADER_I_CACHE<Stype, DSE_StreamWidth_D, opcodestr # ".d">;
+}
+
+multiclass DSE_STREAM_HEADER_I_STYPE<string opcodestr>{
+  defm _LD : DSE_STREAM_HEADER_I_WIDTH<DSE_Stype_LD, opcodestr # ".ld">;
+  defm _ST : DSE_STREAM_HEADER_I_WIDTH<DSE_Stype_ST, opcodestr # ".st">;
+}
+
+// Floating-point
+class DSE_STREAM_HEADER_F<DSE_StreamType Stype, DSE_StreamWidth width,
+                        DSE_StreamCache cachelvl, string opcodestr>
+      : DSE_STREAM_HEADER<Stype, DSE_regtype_F, DSE_StreamDim_NULL, 
+                          DSE_masked_NULL, cachelvl, DSE_indexS_NULL, width, 
+                          (outs FPR32:$sd), (ins GPR:$rs1),
+                          opcodestr, "$sd, $rs1"> {
+  let Predicates = [HasCustomExtDSEF];
+}
+
+multiclass DSE_STREAM_HEADER_F_CACHE<DSE_StreamType Stype, 
+                                     DSE_StreamWidth width,
+                                     string opcodestr>{
+  def "" : DSE_STREAM_HEADER_F<Stype, width, DSE_StreamCache_N, opcodestr>;
+  def _1 : DSE_STREAM_HEADER_F<Stype, width, DSE_StreamCache_1, opcodestr # ".lv1">;
+  def _2 : DSE_STREAM_HEADER_F<Stype, width, DSE_StreamCache_2, opcodestr # ".lv2">;
+  def _3 : DSE_STREAM_HEADER_F<Stype, width, DSE_StreamCache_3, opcodestr # ".lv3">;
+}
+
+multiclass DSE_STREAM_HEADER_F_WIDTH<DSE_StreamType Stype, string opcodestr>{
+  defm _B : DSE_STREAM_HEADER_F_CACHE<Stype, DSE_StreamWidth_B, opcodestr # ".b">;
+  defm _H : DSE_STREAM_HEADER_F_CACHE<Stype, DSE_StreamWidth_H, opcodestr # ".h">;
+  defm _W : DSE_STREAM_HEADER_F_CACHE<Stype, DSE_StreamWidth_W, opcodestr # ".w">;
+  defm _D : DSE_STREAM_HEADER_F_CACHE<Stype, DSE_StreamWidth_D, opcodestr # ".d">;
+}
+
+multiclass DSE_STREAM_HEADER_F_STYPE<string opcodestr>{
+  defm _LD : DSE_STREAM_HEADER_F_WIDTH<DSE_Stype_LD, opcodestr # ".ld">;
+  defm _ST : DSE_STREAM_HEADER_F_WIDTH<DSE_Stype_ST, opcodestr # ".st">;
+}
+
+// Vector
+class DSE_STREAM_HEADER_V<DSE_StreamType Stype, DSE_StreamWidth width, 
+                        DSE_StreamDim vDim, DSE_Predicate pred,
+                        DSE_StreamCache cachelvl, DSE_indexStream indexS, 
+                        string opcodestr>
+      : DSE_STREAM_HEADER<Stype, DSE_regtype_V, vDim, pred, 
+                          cachelvl, indexS, width, 
+                          (outs VR:$sd), (ins GPR:$rs1),
+                          opcodestr, "$sd, $rs1"> {
+  let Predicates = [HasCustomExtDSEV];
+}
+
+multiclass DSE_STREAM_HEADER_V_INDEX<DSE_StreamType Stype, DSE_StreamWidth width,
+                                DSE_StreamDim vDim, DSE_Predicate Spred,
+                                DSE_StreamCache cachelvl, string opcodestr>{
+  def ""    : DSE_STREAM_HEADER_V<Stype, width, vDim, Spred, cachelvl, DSE_indexS_false, opcodestr>;
+  def _INDX : DSE_STREAM_HEADER_V<Stype, width, vDim, Spred, cachelvl, DSE_indexS_true, opcodestr # ".indx">;
+}
+
+multiclass DSE_STREAM_HEADER_V_CACHE<DSE_StreamType Stype, DSE_StreamWidth width, 
+                                  DSE_StreamDim vDim, DSE_Predicate Spred,
+                                  string opcodestr>{
+  defm "" : DSE_STREAM_HEADER_V_INDEX<Stype, width, vDim, Spred, DSE_StreamCache_N, opcodestr>;
+  defm _1 : DSE_STREAM_HEADER_V_INDEX<Stype, width, vDim, Spred, DSE_StreamCache_1, opcodestr # ".lv1">;
+  defm _2 : DSE_STREAM_HEADER_V_INDEX<Stype, width, vDim, Spred, DSE_StreamCache_2, opcodestr # ".lv2">;
+  defm _3 : DSE_STREAM_HEADER_V_INDEX<Stype, width, vDim, Spred, DSE_StreamCache_3, opcodestr # ".lv3">;
