diff --git a/llvm/lib/Target/RISCV/RISCVInstrFormatsDSE.td b/llvm/lib/Target/RISCV/RISCVInstrFormatsDSE.td
new file mode 100644
index 000000000000..afed75ba3232
--- /dev/null
+++ b/llvm/lib/Target/RISCV/RISCVInstrFormatsDSE.td
@@ -0,0 +1,239 @@
+//===-- RISCVInstrFormatsDSE.td - RISCV DSE Instruction Formats --*- tablegen -*-=//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+//  This file describes the DSE extension instruction formats.
+//
+//===----------------------------------------------------------------------===//
+class DSE_regtype<bits<2> regtype> {
+  bits<2> Value = regtype;
+}
+
+def DSE_regtype_I : DSE_regtype<0b00>;
+def DSE_regtype_F : DSE_regtype<0b01>;
+def DSE_regtype_V : DSE_regtype<0b10>;
+def DSE_regtype_NULL : DSE_regtype<0b00>;
+
+class DSE_Instype<bits<2> Itype> {
+  bits<2> Value = Itype;
+}
+
+def DSE_Instype_APP  : DSE_Instype<0b00>;
+def DSE_Instype_END  : DSE_Instype<0b01>;
+def DSE_Instype_STA  : DSE_Instype<0b10>;
+def DSE_Instype_CTRL : DSE_Instype<0b11>;
+def DSE_Instype_NULL : DSE_Instype<0b00>;
+
+class DSE_StreamWidth<bits<2> width> {
+  bits<2> Value = width;
+}
+
+def DSE_StreamWidth_B : DSE_StreamWidth<0b00>;
+def DSE_StreamWidth_H : DSE_StreamWidth<0b01>;
+def DSE_StreamWidth_W : DSE_StreamWidth<0b10>;
+def DSE_StreamWidth_D : DSE_StreamWidth<0b11>;
+def DSE_StreamWidth_NULL : DSE_StreamWidth<0b00>;
+
+
+class DSE_StreamType<bits<2> Stype> {
+  bits<2> Value = Stype;
+}
+
+def DSE_Stype_LD : DSE_StreamType<0b00>;
+def DSE_Stype_ST : DSE_StreamType<0b01>;
+// other options are reserved for future use
+def DSE_Stype_NULL : DSE_StreamType<0b00>;
+
+
+class DSE_StreamDim<bits<2> dim> {
+  bits<2> Value = dim;
+}
+
+def DSE_StreamDim_1 : DSE_StreamDim<0b00>;
+def DSE_StreamDim_2 : DSE_StreamDim<0b01>;
+def DSE_StreamDim_3 : DSE_StreamDim<0b10>;
+def DSE_StreamDim_4 : DSE_StreamDim<0b11>;
+def DSE_StreamDim_NULL : DSE_StreamDim<0b00>;
+
+
+class DSE_Predicate<bits<1> Spred> {
+  bits<1> Value = Spred;
+}
+
+def DSE_masked      : DSE_Predicate<0b0>;
+def DSE_unmasked    : DSE_Predicate<0b1>;
+def DSE_masked_NULL : DSE_Predicate<0b0>;
+
+
+class DSE_StreamCache<bits<2> cachelvl> {
+  bits<2> Value = cachelvl;
+}
+def DSE_StreamCache_N : DSE_StreamCache<0b00>;
+def DSE_StreamCache_1 : DSE_StreamCache<0b01>;
+def DSE_StreamCache_2 : DSE_StreamCache<0b10>;
+def DSE_StreamCache_3 : DSE_StreamCache<0b11>;
+def DSE_StreamCache_NULL : DSE_StreamCache<0b00>;
+
+
+class DSE_indexStream<bits<1> indexS> {
+  bits<1> Value = indexS;
+}
+def DSE_indexS_false : DSE_indexStream<0b0>;
+def DSE_indexS_true  : DSE_indexStream<0b1>;
+def DSE_indexS_NULL  : DSE_indexStream<0b0>;
+
+
+class DSE_ModiferTarget<bits<2> mtarget> {
+  bits<2> Value = mtarget;
+}
+
+def DSE_ModiferTarget_SIZE   : DSE_ModiferTarget<0b00>;
+def DSE_ModiferTarget_STRIDE : DSE_ModiferTarget<0b01>;
+def DSE_ModiferTarget_OFFSET : DSE_ModiferTarget<0b10>;
+def DSE_ModiferTarget_NULL   : DSE_ModiferTarget<0b00>;
+
+
+class DSE_ModifierBehaviour<bits<3> behaviour> {
+  bits<3> Value = behaviour;
+}
+
+def DSE_ModifierBehaviour_INC  : DSE_ModifierBehaviour<0b000>;
+def DSE_ModifierBehaviour_DEC  : DSE_ModifierBehaviour<0b001>;
+def DSE_ModifierBehaviour_ADD  : DSE_ModifierBehaviour<0b010>;
+def DSE_ModifierBehaviour_SUB  : DSE_ModifierBehaviour<0b011>;
+def DSE_ModifierBehaviour_SET  : DSE_ModifierBehaviour<0b100>;
+// def DSE_ModifierBehaviour_NULL : DSE_ModifierBehaviour<0b000>;
+
+class DSE_ModiferType<bits<2> mtype> {
+  bits<2> Value = mtype;
+}
+
+def DSE_ModiferType_SMOD : DSE_ModiferType<0b00>;
+def DSE_ModiferType_DMOD : DSE_ModiferType<0b01>;
+def DSE_ModiferType_NULL : DSE_ModiferType<0b00>;
+
+//===----------------------------------------------------------------------===//
+// DSE Stream Instructions Class Formats
+//===----------------------------------------------------------------------===//
+class DSE_STREAM_HEADER<DSE_StreamType Stype, DSE_regtype regtype, 
+                        DSE_StreamDim eDim, DSE_Predicate pred,
+                        DSE_StreamCache cachelvl, DSE_indexStream indexS, 
+                        DSE_StreamWidth width, dag outs, dag ins, 
+                        string opcodestr, string argstr>
+    : RVInst<outs, ins, opcodestr, argstr, [], InstFormatR> {
+  bits<5> rs1;
+  bits<5> sd;
+
+  let Inst{31}    = indexS.Value;
+  let Inst{30-29} = Stype.Value;
+  let Inst{28-27} = cachelvl.Value;
+  let Inst{26-25} = regtype.Value;
+  let Inst{24-23} = eDim.Value;
+  let Inst{22}    = pred.Value;
+  let Inst{21-20} = width.Value;
+  let Inst{19-15} = rs1;
+  let Inst{14-13} = DSE_Instype_STA.Value;
+  let Inst{12}    = 0b0;
+  let Inst{11-7}  = sd;
+  let Opcode      = OPC_CUSTOM_0.Value;
+}
+
+class DSE_STREAM_DIM<DSE_regtype regtype, DSE_Instype instype, 
+                     dag outs, dag ins, 
+                     string opcodestr, string argstr>
+    : RVInst<outs, ins, opcodestr, argstr, [], InstFormatR> {
+  bits<5> rs3;
+  bits<5> rs2;
+  bits<5> rs1;
+  bits<5> sd;
+
+  let Inst{31-27} = rs3;
+  let Inst{26-25} = regtype.Value;
+  let Inst{24-20} = rs2;
+  let Inst{19-15} = rs1;
+  let Inst{14-13} = instype.Value;
+  let Inst{12}    = 0b0;
+  let Inst{11-7}  = sd;
+  let Opcode      = OPC_CUSTOM_0.Value;
+}
+
+class DSE_STREAM_MOD<DSE_Instype instype, DSE_ModiferType mtype, DSE_regtype regtype, 
+                     DSE_ModiferTarget target, DSE_ModifierBehaviour behaviour,
+                     DSE_StreamDim tDim, dag outs, dag ins,
+                     string opcodestr, string argstr>
+    : RVInst<outs, ins, opcodestr, argstr, [], InstFormatR> {
+  bits<5> ss1;
+  bits<5> sd;
+
+  let Inst{31-30} = mtype.Value;
+  let Inst{29-28} = tDim.Value;
+  let Inst{27}    = 0b0;
+  let Inst{26-25} = regtype.Value;
+  let Inst{24-22} = behaviour.Value;
+  let Inst{21-20} = target.Value;
+  let Inst{19-15} = ss1;
+  let Inst{14-13} = instype.Value;
+  let Inst{12}    = 0b1;
+  let Inst{11-7}  = sd;
+  let Opcode      = OPC_CUSTOM_0.Value;
+}
+
+//===----------------------------------------------------------------------===//
+// Branch Instruction Class Format
+//===----------------------------------------------------------------------===//
+class DSE_BRANCH<DSE_regtype regtype, bits<1> comp, DSE_StreamDim hop,
+                   dag outs, dag ins, string opcodestr, string argstr>
+    : RVInst<outs, ins, opcodestr, argstr, [], InstFormatB> {
+  bits<12> imm12;
+  // bits<5> compat; // Makes intruction compatible with current dissasembly, do not remove
+  bits<5> ss1;
+
+  let Inst{31}    = imm12{11};
+  let Inst{30-25} = imm12{9-4};
+  let Inst{24-23} = regtype.Value;
+  let Inst{22-21} = hop.Value;
+  let Inst{20}    = comp;
+  let Inst{19-15} = ss1;
+  let Inst{14-13} = DSE_Instype_CTRL.Value;
+  let Inst{12}    = 0b0;
+  let Inst{11-8}  = imm12{3-0};
+  let Inst{7}     = imm12{10};
+  let Opcode      = OPC_CUSTOM_0.Value;
+}
+
+
+//===----------------------------------------------------------------------===//
+// Control Instruction Class Formats
+//===----------------------------------------------------------------------===//
+
+class DSE_CONTROL<DSE_regtype regtype, bits<3> sctrltype, 
+                  dag outs, dag ins, string opcodestr, string argstr>
+    : RVInst<outs, ins, opcodestr, argstr, [], InstFormatR> {
+  bits<5> sd;
+
+  let Inst{31-25} = 0;
+  let Inst{24-23} = regtype.Value;
+  let Inst{22-20} = sctrltype;
+  let Inst{14-13} = DSE_Instype_CTRL.Value;
+  let Inst{12}    = 0b1;
+  let Inst{11-7}  = sd;
+  let Opcode = OPC_CUSTOM_0.Value;
+}
+
+class DSE_CONTROL_GLOBAL<DSE_regtype regtype, bits<3> sctrltype, 
+                         dag outs, dag ins, string opcodestr, string argstr>
+    : RVInst<outs, ins, opcodestr, argstr, [], InstFormatR> {
+
+  let Inst{31-25} = 0;
+  let Inst{24-23} = regtype.Value;
+  let Inst{22-20} = sctrltype;
+  let Inst{19-15} = 0;
+  let Inst{14-13} = DSE_Instype_CTRL.Value;
+  let Inst{12}    = 0b1;
+  let Inst{11-7}  = 0;
+  let Opcode = OPC_CUSTOM_0.Value;
+}
